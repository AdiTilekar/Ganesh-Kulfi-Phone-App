    <!-- Brand Story -->
    <string name="brand_story_heritage">Our Heritage</string>
    <string name="brand_story_title">A Legacy of Sweetness</string>
    <string name="brand_story_p1">Founded by Ganesh Raut, Shree Ganesh Kulfi is more than just a sweet shop; it\'s a cherished tradition passed down through generations. Our journey began in the heart of Kopargaon with a simple mission: to share the authentic, unforgettable taste of homemade kulfi with our community.</string>
    <string name="brand_story_p2">We use only the purest milk, the finest nuts, and fragrant spices, slow-churned to creamy perfection. Every bite is a testament to our commitment to quality and the rich cultural heritage of Maharashtra.</string>
    
